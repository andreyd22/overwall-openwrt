#!/bin/sh /etc/rc.common
USE_PROCD=1
start_service() {
	[ -s /var/run/overwall/xray.json ] || return 1
	procd_open_instance
	procd_set_param command /usr/bin/xray run -config /var/run/overwall/xray.json
	procd_set_param respawn 3600 5 5
	procd_set_param file /var/run/overwall/xray.json
	procd_close_instance
}
